{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/types/**/*.ts",
    "src/api/client.js",
    "src/stores/session.js",
    "src/utils/agentStream.js",
    "src/utils/projectRestore.js",
    "src/utils/reportMarkdown.js",
    "src/utils/frameScheduler.js",
    "tests/types/**/*.ts",
    "src/utils/chatScroll.js",
    "src/utils/questionContext.js"
  ]
}
